{
  "description": "devloop plugin hooks for Codex: supported event subset plus Codex fallbacks for state refresh",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "DEVLOOP_HARNESS=codex \"${CLAUDE_PLUGIN_ROOT}/scripts/node\" \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/runtime.js\"",
            "timeout": 5,
            "statusMessage": "Checking devloop policy"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "DEVLOOP_HARNESS=codex \"${CLAUDE_PLUGIN_ROOT}/scripts/node\" \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/runtime.js\"",
            "timeout": 10,
            "statusMessage": "Initializing devloop session"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DEVLOOP_HARNESS=codex \"${CLAUDE_PLUGIN_ROOT}/scripts/node\" \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/runtime.js\"",
            "timeout": 3,
            "statusMessage": "Releasing devloop owner locks"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DEVLOOP_HARNESS=codex \"${CLAUDE_PLUGIN_ROOT}/scripts/node\" \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/runtime.js\"",
            "timeout": 10,
            "statusMessage": "Injecting devloop context"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "DEVLOOP_HARNESS=codex \"${CLAUDE_PLUGIN_ROOT}/scripts/node\" \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/runtime.js\"",
            "timeout": 5,
            "statusMessage": "Re-injecting devloop state after compaction"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "DEVLOOP_HARNESS=codex \"${CLAUDE_PLUGIN_ROOT}/scripts/node\" \"${CLAUDE_PLUGIN_ROOT}/dist/hooks/runtime.js\"",
            "timeout": 10,
            "statusMessage": "Recording tool activity"
          }
        ]
      }
    ]
  }
}
