{
  "name": "@compforge/devloop",
  "version": "0.4.48",
  "description": "Shared dev-loop runtime with Claude Code, Codex, DeepSeek Harness, and OpenCode V2 adapters.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh.d.ts",
      "default": "./dist/adapters/dsh.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./server": {
      "types": "./dist/adapters/opencode.d.ts",
      "default": "./server.js"
    }
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "commands/",
    "config/",
    "hooks/*.json",
    "monitors/",
    "tasks/",
    "scripts/",
    "!scripts/tests/",
    "!scripts/**/__pycache__/",
    "!scripts/**/*.pyc",
    "references/",
    "skills/",
    ".claude-plugin/",
    ".codex-plugin/",
    "server.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild hooks/runtime.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/hooks/runtime.js",
    "check": "npm run typecheck && npm test",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.1",
    "@opencode/plugin": "^2.1.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "@compforge/repocli": "^0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.1",
    "@opencode/plugin": "^2.1.2",
    "@types/node": "^24.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
