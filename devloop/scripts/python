#!/bin/sh
# uv owns the locked script environment; neither the plugin nor the target needs a venv.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v uv >/dev/null 2>&1; then
    echo "devloop: uv is required for Python workflows; install uv and retry" >&2
    exit 127
fi
exec uv run --no-config --no-env-file --locked --python "${DEVLOOP_PYTHON:->=3.11}" \
    --script "$script_dir/_python.py" "$@"
